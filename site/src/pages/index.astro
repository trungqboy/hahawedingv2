---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import { buildGalleryItems, expandGalleryFeed, galleryImagesFallback } from '../data/gallery';

const imagesDir = path.join(process.cwd(), 'public', 'images');
let galleryImages = galleryImagesFallback;

if (fs.existsSync(imagesDir)) {
  const files = fs.readdirSync(imagesDir);
  const built = buildGalleryItems(files);
  if (built.length > 0) galleryImages = expandGalleryFeed(built);
}
---

<Layout
  title="HaHa Wedding Studio | Chụp ảnh cưới &amp; trang điểm"
  description="Studio chụp ảnh cưới và trang điểm — ảnh chân thật, ánh sáng tự nhiên, phong cách editorial."
>
  <SiteHeader current="home" />
  <main class="bg-cream min-h-screen pt-[7.25rem] md:pt-[6.5rem]">
    <div class="sr-only">
      <h1>HaHa Wedding Studio — Portfolio ảnh cưới</h1>
      <p>{galleryImages.length} ảnh</p>
    </div>
    <PortfolioGrid items={galleryImages} />
  </main>
  <SiteFooter />
</Layout>
