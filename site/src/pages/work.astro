---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { projectCoverSrc, projects } from '../data/projects';

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Work | HaHa Wedding Studio"
  description="Portfolio ảnh cưới theo từng cặp đôi — HaHa Wedding Studio, Quảng Bình."
>
  <SiteHeader current="work" />
  <main class="bg-cream min-h-screen pt-[7.25rem] md:pt-[5.5rem]">
    <div class="work-index">
      <h1 class="sr-only">Work — HaHa Wedding Studio</h1>

      <ul class="work-index__grid">
        {
          projects.map((project, index) => (
            <li class="work-index__cell">
              <a href={`${base}work/${project.slug}/`} class="work-album group">
                <img
                  src={projectCoverSrc(project)}
                  alt={project.title}
                  class="work-album__img"
                  loading={index < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                  width="900"
                  height="1125"
                />
                <span class="work-album__label" aria-hidden="true">{project.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <SiteFooter />
</Layout>
